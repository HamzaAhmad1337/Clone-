{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://highwayrush.dev/schemas/vehicle.schema.json",
  "title": "Highway Rush vehicle definition",
  "type": "object",
  "required": ["id", "displayNameKey", "marque", "class", "unlock", "physics", "powertrain", "derivedStats", "visual", "audio"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "displayNameKey": { "type": "string", "pattern": "^vehicle\\.[a-z0-9_]+\\.name$" },
    "marque": { "type": "string" },
    "class": {
      "type": "string",
      "enum": ["Starter", "Economy", "HotHatch", "Sedan", "Muscle", "Sports", "Super",
               "Hyper", "Luxury", "SUV", "Pickup", "Van", "OffRoad", "Classic",
               "Electric", "Track", "Bike", "Special"]
    },
    "unlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priceCoins": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000000 },
        "priceCash": { "type": ["integer", "null"], "minimum": 0 },
        "driverLevel": { "type": "integer", "minimum": 1, "maximum": 100 },
        "achievement": { "type": ["string", "null"] },
        "event": { "type": ["string", "null"] }
      },
      "required": ["driverLevel"]
    },
    "physics": {
      "type": "object",
      "required": ["massKg", "centreOfMass", "wheelbaseM", "widthM", "driveLayout", "steeringLockDeg", "suspension"],
      "properties": {
        "massKg": { "type": "number", "minimum": 150, "maximum": 3500 },
        "centreOfMass": {
          "type": "object",
          "required": ["wheelbaseFraction", "heightM"],
          "properties": {
            "wheelbaseFraction": { "type": "number", "minimum": 0.30, "maximum": 0.70 },
            "heightM": { "type": "number", "minimum": 0.25, "maximum": 1.10 }
          }
        },
        "wheelbaseM": { "type": "number", "minimum": 1.2, "maximum": 4.0 },
        "trackFrontM": { "type": "number", "minimum": 0.4, "maximum": 2.4 },
        "trackRearM": { "type": "number", "minimum": 0.4, "maximum": 2.4 },
        "widthM": { "type": "number", "minimum": 0.6, "maximum": 2.4 },
        "lengthM": { "type": "number", "minimum": 1.8, "maximum": 6.5 },
        "dragCoefficient": { "type": "number", "minimum": 0.15, "maximum": 0.90 },
        "frontalAreaM2": { "type": "number", "minimum": 0.5, "maximum": 4.5 },
        "downforceCoefficientFront": { "type": "number", "minimum": 0, "maximum": 3.0,
          "description": "Positive = downforce. Negative values are rejected on purpose." },
        "downforceCoefficientRear": { "type": "number", "minimum": 0, "maximum": 3.0 },
        "driveLayout": { "type": "string", "enum": ["FWD", "RWD", "AWD", "FourWD"] },
        "driveSplitFrontPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "tyreRadiusM": { "type": "number", "minimum": 0.20, "maximum": 0.60 },
        "tyreWidthM": { "type": "number", "minimum": 0.08, "maximum": 0.40 },
        "defaultCompound": {
          "type": "string",
          "enum": ["Stock", "Touring", "Sport", "SemiSlick", "AllTerrain", "Winter"]
        },
        "steeringLockDeg": { "type": "number", "minimum": 15, "maximum": 45 },
        "suspension": {
          "type": "object",
          "required": ["restLengthM", "travelM", "springStiffnessNPerM", "damperRateNsPerM"],
          "properties": {
            "restLengthM": { "type": "number", "minimum": 0.15, "maximum": 0.60 },
            "travelM": { "type": "number", "minimum": 0.08, "maximum": 0.45 },
            "springStiffnessNPerM": { "$ref": "#/$defs/axlePair", "minimum": 15000, "maximum": 120000 },
            "damperRateNsPerM": { "$ref": "#/$defs/axlePair" },
            "antiRollStiffnessNPerM": { "$ref": "#/$defs/axlePair" },
            "maxForceMultiplier": { "type": "number", "minimum": 1.5, "maximum": 6.0 }
          }
        }
      }
    },
    "powertrain": {
      "type": "object",
      "required": ["engineFamily", "idleRpm", "maxRpm", "redlineRpm", "torqueCurveNm", "transmission"],
      "properties": {
        "engineFamily": {
          "type": "string",
          "enum": ["I3", "I4", "I4Turbo", "I6", "V6", "V6Turbo", "V8", "V8Supercharged",
                   "V10", "V12", "Flat6", "Rotary", "Electric", "DieselI6", "MotorcycleI4"]
        },
        "displacementL": { "type": "number", "minimum": 0, "maximum": 9.0 },
        "cylinders": { "type": "integer", "minimum": 0, "maximum": 12 },
        "idleRpm": { "type": "integer", "minimum": 0, "maximum": 2000 },
        "maxRpm": { "type": "integer", "minimum": 1000, "maximum": 20000 },
        "redlineRpm": { "type": "integer", "minimum": 1000, "maximum": 20000 },
        "torqueCurveNm": {
          "type": "array", "minItems": 6, "maxItems": 12,
          "items": {
            "type": "array", "minItems": 2, "maxItems": 2,
            "items": { "type": "number", "minimum": 0 }
          }
        },
        "engineBrakeCoefficient": { "type": "number", "minimum": 0, "maximum": 0.6 },
        "inertiaKgM2": { "type": "number", "minimum": 0.02, "maximum": 2.0 },
        "transmission": {
          "type": "object",
          "required": ["type", "gearRatios", "finalDrive", "shiftTimeMs", "efficiency"],
          "properties": {
            "type": { "type": "string", "enum": ["Automatic", "Sequential", "Manual", "Single"] },
            "gearRatios": { "type": "array", "minItems": 1, "maxItems": 9,
                            "items": { "type": "number", "minimum": 0.4, "maximum": 6.0 } },
            "finalDrive": { "type": "number", "minimum": 1.5, "maximum": 6.5 },
            "shiftTimeMs": { "type": "integer", "minimum": 0, "maximum": 900 },
            "efficiency": { "type": "number", "minimum": 0.75, "maximum": 1.0 }
          }
        },
        "nitrous": {
          "type": "object",
          "properties": {
            "capacitySeconds": { "type": "number", "minimum": 0, "maximum": 9.0 },
            "torqueMultiplier": { "type": "number", "minimum": 1.0, "maximum": 1.8 },
            "refillSeconds": { "type": "number", "minimum": 5.0, "maximum": 30.0 }
          }
        }
      }
    },
    "derivedStats": {
      "type": "object",
      "required": ["topSpeedKmh", "zeroToHundredS"],
      "properties": {
        "topSpeedKmh": { "type": "number", "minimum": 100, "maximum": 450 },
        "zeroToHundredS": { "type": "number", "minimum": 1.5, "maximum": 20.0 },
        "hundredToZeroM": { "type": "number", "minimum": 20, "maximum": 90 },
        "peakPowerKw": { "type": "number", "minimum": 30, "maximum": 900 },
        "peakPowerRpm": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "handlingRating": { "type": "integer", "minimum": 0, "maximum": 100 },
        "brakingRating": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "visual": { "type": "object" },
    "audio": { "type": "object" },
    "upgradeCaps": { "type": "object" },
    "tags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "axlePair": {
      "type": "object",
      "required": ["front", "rear"],
      "additionalProperties": false,
      "properties": {
        "front": { "type": "number", "minimum": 0 },
        "rear": { "type": "number", "minimum": 0 }
      }
    }
  }
}
